# Copy to .env and fill in. Never commit .env.
# The run wrapper passes these to k6; scripts read them via __ENV.

# Which entry in config/environments to target. "local" is the bundled mock service.
HARNESS_ENV=local

# Password for the test users of the system under test.
# The bundled mock accepts any password; usernames come from the service's users.json.
SUT_PASSWORD=local-mock-password

# Optional: stream k6 metrics over OpenTelemetry when a run is started with --otel.
# Protocol is "grpc" or "http/protobuf"; set the endpoint variable that matches it.
# K6_OTEL_EXPORTER_PROTOCOL=http/protobuf
# K6_OTEL_HTTP_EXPORTER_ENDPOINT=localhost:4318
# K6_OTEL_HTTP_EXPORTER_INSECURE=true
# K6_OTEL_GRPC_EXPORTER_ENDPOINT=localhost:4317
# K6_OTEL_GRPC_EXPORTER_INSECURE=true
# K6_OTEL_SERVICE_NAME=k6-harness
