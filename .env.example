# Copy to .env and fill in. Never commit .env.
# The run wrapper passes these to k6; scripts read them via __ENV.

# Which entry in config/environments to target. "local" is the bundled mock service.
HARNESS_ENV=local

# Credentials for the system under test (used by the auth helper).
SUT_USERNAME=
SUT_PASSWORD=

# Optional: OpenTelemetry endpoint for exporting k6 metrics.
K6_OTEL_EXPORTER_OTLP_ENDPOINT=
